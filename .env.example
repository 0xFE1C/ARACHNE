# ARACHNE configuration template. Copy to .env for LOCAL development only —
# .env is gitignored and must never be committed .
#
# Every value below is read by arachne.core.config.Settings.from_env(); the file is
# documentation, not a required input (ARACHNE reads the process environment).

# ---- evidence store ------------------------------------------------------------
# SQLite by default; Postgres is supported by the same schema (ADR-03).
ARACHNE_DATABASE_URL=sqlite:///arachne.db

# ---- read replicas (REQ-SCALE-011, WP-17) --------------------------------------
# Comma-separated database URLs the control plane may read from. Writes always go to
# ARACHNE_DATABASE_URL; these are read-only targets for the catalogue/listing endpoints.
# A replica that cannot be reached degrades to the primary with a log line and the
# arachne_read_replica_failovers_total counter. Empty (the default) means every read goes
# to the primary. Reads through a replica may lag the last write — that is the documented
# consistency model; never point a mutation's own response at one.
# ARACHNE_DATABASE_REPLICA_URLS=postgresql+psycopg://arachne@replica1:5432/arachne

# ---- deployment scope (F-01-02, F-01-09) ---------------------------------------
# An ADDITIONAL allowlist, applied when a scan is *defined*: every target in a target
# definition must be allowed by this scope, or the scan is refused and the refusal is
# audited. Leave empty for no extra restriction (an arachne scan --target FIXTURE then
# relies on the fixture's own declared scope and its authorization attestation), and
# remember that the request-time scope always denies anything not declared in the
# definition: an empty scope contacts nothing (F-01-02).
# Hosts are exact matches; wildcards match subdomains only ("*.example.com").
ARACHNE_SCOPE_HOSTS=
# Domains match the apex and every subdomain.
ARACHNE_SCOPE_DOMAINS=
# CIDR ranges, for address-space targets.
ARACHNE_SCOPE_NETWORKS=
# URL prefixes, for path-scoped targets.
ARACHNE_SCOPE_URL_PREFIXES=
# Git/cloud references ("aws:123456789012", "aws:*", "https://github.com/org/repo.git").
ARACHNE_SCOPE_REFS=
# Exclusions always win over an allow. A network exclusion denies a target range only when
# it covers it entirely; per-address exclusions still apply to every request.
ARACHNE_SCOPE_EXCLUDE_HOSTS=
ARACHNE_SCOPE_EXCLUDE_DOMAINS=
ARACHNE_SCOPE_EXCLUDE_NETWORKS=
ARACHNE_SCOPE_EXCLUDE_URL_PREFIXES=
ARACHNE_SCOPE_EXCLUDE_REFS=

# ---- planning (F-01-10) --------------------------------------------------------
# The dry run never resolves a name, so what it cannot know offline is an explicit
# assumption, printed with the plan. Host counts for wide ranges are capped so a /8
# cannot produce a nonsense estimate.
ARACHNE_PLAN_ASSUMED_SUBDOMAINS=0
ARACHNE_PLAN_MAX_HOSTS_PER_NETWORK=256

# ---- URL safety (F-08-03) -----------------------------------------------------
# Leave these false in production. They exist for the local lab fixtures.
ARACHNE_ALLOW_PRIVATE_IPS=false
ARACHNE_ALLOW_LOOPBACK=false
ARACHNE_ALLOW_LINK_LOCAL=false

# ---- rate limits (F-01-07) ----------------------------------------------------
ARACHNE_RATE_LIMIT_PER_HOST=5
ARACHNE_RATE_LIMIT_PER_HOST_BURST=5
ARACHNE_RATE_LIMIT_GLOBAL=20
ARACHNE_RATE_LIMIT_GLOBAL_BURST=20

# ---- HTTP --------------------------------------------------------------------
ARACHNE_HTTP_TIMEOUT_S=15
ARACHNE_HTTP_CONNECT_TIMEOUT_S=5
ARACHNE_HTTP_MAX_REDIRECTS=5
ARACHNE_HTTP_MAX_BODY_BYTES=65536
ARACHNE_HTTP_RETRIES=1
ARACHNE_HTTP_VERIFY_TLS=true
# ARACHNE_HTTP_USER_AGENT=ARACHNE/0.1 (+https://localhost/arachne) defensive-security-scanner

# ---- observability -----------------------------------------------------------
ARACHNE_LOG_LEVEL=INFO
ARACHNE_LOG_JSON=true
# Append audit events to a JSONL file as well as the configured sinks (F-01-08).
# ARACHNE_AUDIT_LOG_PATH=/var/log/arachne/audit.jsonl
ARACHNE_ACTOR=cli

# ---- deployment --------------------------------------------------------------
# Where alembic.ini/migrations live, when it is not the working directory or the
# source tree (used by the container image and by packaged installs).
# ARACHNE_PROJECT_ROOT=/app

# ---- AI providers (stage S9) -------------------------------------------------
# Keys are read from the environment, never logged, never written to evidence or
# reports (F-08-01). Redaction is enabled by default (F-04-08); keep it on unless you
# have a reviewed reason not to.
ARACHNE_REDACTION_ENABLED=true
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ---- module framework (S3, F-02-09/F-02-10) ----------------------------------
# `arachne module list` shows what is installed; `arachne coverage` shows which
# research methods the checks map to (G-01). Both are read-only and need no database.

# ---- passive OSINT (M1: reconnaissance, F-02-02) -----------------------------
# M1 queries *other people's* indexes (certificate transparency, web archives, scan
# databases). That is OFF by default: nothing in a scan contacts a third party unless
# this is set, which is what keeps a default scan offline and predictable (F-02-09).
# ARACHNE_OSINT_ENABLED=true
# Which sources may be contacted. The OSINT client's scope is exactly these hosts, so
# an index that is not named here is out of scope and the request is refused and
# audited. Known providers: crtsh, circl, wayback, commoncrawl, internetdb, github,
# search, vulners. Default: the five keyless ones.
# ARACHNE_OSINT_PROVIDERS=crtsh,circl,wayback,commoncrawl,internetdb
# The search API used by the dork sweep and email harvesting: any endpoint returning
# {"results": [{"url", "title", "content"}]} (a self-hosted SearxNG works). Its host is
# added to the OSINT scope automatically.
# ARACHNE_OSINT_SEARCH_URL=https://searx.example/search?q={query}&limit={limit}&format=json
# Path to a dork corpus (F-09-04). Defaults to the corpus shipped with ARACHNE.
# ARACHNE_OSINT_DORK_CORPUS=/etc/arachne/dorks.yaml
# Pinned Common Crawl crawl for the archive harvest.
# ARACHNE_OSINT_COMMONCRAWL_INDEX=CC-MAIN-2024-51
# Bound on third-party requests per scan, results per query, and assets recorded per
# check. A budget that runs out is recorded, not an error.
ARACHNE_OSINT_REQUEST_BUDGET=60
ARACHNE_OSINT_MAX_RESULTS=100
ARACHNE_OSINT_MAX_ASSETS=500
# Additional hosts the OSINT client may contact (e.g. a private mirror).
ARACHNE_OSINT_EXTRA_HOSTS=
# A GitHub token enables `m1.code-secret-mining` (opt-in, token budgeted, F-08-01).
# Read from the environment only and never logged. Absent = the check reports a skip.
# ARACHNE_GITHUB_TOKEN=

# ---- recorded-response replay ------------------------------
# Point either of these at a directory (or file) of recorded JSON responses to run a
# scan with no network at all: everything else about the request path — scope, rate
# limiting, redaction, audit — is unchanged, so a replay exercises the real code.
# ARACHNE_HTTP_FIXTURES=/etc/arachne/recordings        # target-scoped client
# ARACHNE_OSINT_FIXTURES=/etc/arachne/osint-recordings # third-party OSINT client

# ---- network probes (M2: hosts, ports, services, TLS) -------------------------
# Every M2 check is *active* (it contacts the target), so F-01-09 applies twice: the scan
# needs `--active-checks` and an attestation that authorizes active checks, and the two
# switches below gate the probes that are extra-sensitive even among active ones.
#
# UDP probing is OFF by default: a UDP probe is unacknowledged and unreliably attributed,
# and the protocols it reaches (SNMP, BACnet) are the most sensitive in an estate. The
# checks that need it report themselves skipped until this is true.
ARACHNE_NET_ALLOW_UDP=false
# Connection/read timeouts, the unprompted-banner window, and the per-connection read cap.
ARACHNE_NET_CONNECT_TIMEOUT_S=3
ARACHNE_NET_READ_TIMEOUT_S=2
ARACHNE_NET_BANNER_WAIT_S=0.75
ARACHNE_NET_MAX_READ_BYTES=8192
# The port policy: how many TCP ports of `templates/m2/ports.yaml` the port scan probes,
# how many hosts one declared unit may expand to, and how many probes run at once.
ARACHNE_NET_MAX_PORTS=100
ARACHNE_NET_MAX_HOSTS=64
ARACHNE_NET_CONCURRENCY=24
# Optional external tooling. `python-nmap` + the nmap binary are used for port/service
# detection when both are present (a pure-Python connect scanner is the fallback, and the
# only path that needs no privileges). `ARACHNE_NET_TLS_TOOL` runs testssl.sh or sslscan in
# addition to the stdlib TLS probe, with a fixed argument vector and no shell.
ARACHNE_NET_NMAP_ENABLED=true
# ARACHNE_NET_TLS_TOOL=/usr/local/bin/testssl.sh
# Cipher suites the stdlib TLS probe tries one at a time (comma-separated). Defaults to
# the shipped weak-suite list; a shorter list trades depth for scan time.
# ARACHNE_NET_TLS_CIPHERS=RC4-SHA,3DES-CBC3-SHA,NULL-SHA
# Lockout-safe pacing for the enumerations that touch accounts or mailboxes. The defaults
# are deliberately slow; make them faster only against a lab you own.
ARACHNE_KERBEROS_PACING_S=1.5
ARACHNE_KERBEROS_MAX_NAMES=12
ARACHNE_SMTP_PACING_S=0.4
# Managed data (F-09-03/04): replace the shipped port catalogue, the offline CVE/EPSS index
# or the wordlists with your own. A path to a file (catalogue/index) or a directory
# (wordlists: smtp-users.txt, kerberos-users.txt, dns-subdomains.txt, snmp-communities.txt).
# ARACHNE_PORT_CATALOG=/etc/arachne/ports.yaml
# ARACHNE_CVE_INDEX=/etc/arachne/cve-index.yaml
# ARACHNE_WORDLISTS_DIR=/etc/arachne/wordlists
# Optional online CVE/EPSS enrichment for `m2.cve-correlate` (F-09-03). The offline index is
# the default path; this key is used only when the `vulners` provider is also enabled.
# ARACHNE_VULNERS_API_KEY=

# ---- heuristic engine (S5: analysis, correlation, scoring, narrative) ----------------
# The engine's data files are managed data (F-09-04): point any of these at your own file to
# replace the shipped corpus without touching code. The shipped defaults need no configuration.
# ARACHNE_ANALYSIS_RULES=/etc/arachne/heuristic-rules.yaml
# ARACHNE_ANALYSIS_CORRELATION=/etc/arachne/correlation-rules.yaml
# ARACHNE_ANALYSIS_NARRATIVE=/etc/arachne/narrative-templates.yaml
# ARACHNE_ANALYSIS_SCORING=/etc/arachne/cvss-vectors.yaml
# ARACHNE_REMEDIATION_CATALOG=/etc/arachne/remediation-catalog.yaml
# ARACHNE_FP_FILTERS=/etc/arachne/fp-filters.yaml
# Extra template directories (nuclei-format or native signatures), loaded with the bundle.
# ARACHNE_SIGNATURE_DIRS=/etc/arachne/templates
# Verification (F-05-07): re-request verifiable candidates once, through the scan's own
# scoped client. A contradiction drops the finding (status `fp`) unless the drop is disabled.
ARACHNE_ANALYSIS_VERIFY=true
ARACHNE_ANALYSIS_MAX_VERIFICATIONS=25
ARACHNE_ANALYSIS_DROP_ON_CONTRADICTION=true
ARACHNE_ANALYSIS_DROP_ON_PLACEHOLDER=true
# Findings below this confidence are reported as low-confidence observations .
ARACHNE_MIN_CONFIDENCE=55
# Correlation (dedupe + compound findings) and the operator-feedback confidence tuner.
ARACHNE_CORRELATION_ENABLED=true
ARACHNE_FP_TUNER=true
# Asset criticality feeds the OWASP impact term: `pattern=level` pairs, comma-separated.
# Levels: critical | high | normal | medium | low | internal. Unmatched assets are `normal`.
# ARACHNE_ASSET_CRITICALITY=example.com=high,*.internal=critical,192.0.2.0/24=low

# ---- web application checks (S6: M3 core families) -----------------------------------
# Bounds for the M3 crawl and its oracles. The crawl is breadth-first, same-origin and
# GET-only, and every knob exists so "one check" can never become "a fuzzing campaign"
# (F-01-07): max pages/depth bound the walk, max params bounds each oracle, and the timing
# pair bounds the one blocking-sleep probe a parameter may receive.
ARACHNE_WEB_MAX_PAGES=20
ARACHNE_WEB_MAX_DEPTH=2
ARACHNE_WEB_MAX_PARAMS=6
ARACHNE_WEB_MAX_ENDPOINTS=200
ARACHNE_WEB_TIME_DELAY_S=3.0
ARACHNE_WEB_TIME_DELTA_S=2.0
# `m3.api-surface`: how many hidden-path wordlist entries to probe.
ARACHNE_WEB_HIDDEN_PATHS=40
# `m3.rate-limit-audit`: requests per sequence (a profile, never a brute-force). Minimum 2.
ARACHNE_WEB_RATE_PROBES=5
# M3 oracles read the raw 3xx they asked for (open-redirect reads Location), so redirects are
# not followed. Set true only if you want the crawled page set to include redirect targets.
ARACHNE_WEB_FOLLOW_REDIRECTS=false
# `m3.upload-audit` stores one inert plain-text marker to test upload validation. OFF by
# default: the M3 safety rules forbid stored payloads unless an operator opts in explicitly.
ARACHNE_WEB_UPLOAD_PROBE=false
# Optional demo session for authenticated surfaces (F-08-01: environment only, never a
# fixture). `SESSION_COOKIE` is sent as the Cookie header; `SESSION_B_COOKIE` is the second
# identity `m3.idor-oracle` uses for its cross-account differential; `AUTH_HEADER` is a raw
# `Name: value` header (e.g. `Authorization: Bearer ...`). All three are redacted at capture.
# ARACHNE_WEB_SESSION_COOKIE=PHPSESSID=...; security=low
# ARACHNE_WEB_SESSION_B_COOKIE=PHPSESSID=...
# ARACHNE_WEB_AUTH_HEADER=Authorization: Bearer ...
# Managed data (F-09-04): a file or directory replacing the shipped M3 payload corpus
# (payloads.yaml + wordlists/hidden-paths.txt).
# ARACHNE_WEB_PAYLOADS=/etc/arachne/m3
# `m3.dom-xss`: crawl JavaScript-rendered routes and DOM sinks in a headless browser
# (WP-11, REQ-DET-015). OFF by default, and two gates turn it on: the optional extra must be
# installed (`pip install arachne[browser]`) *and* this flag must be true. A browser engine
# inside the scanner is a new attack surface (risk R-16), so it is the operator's opt-in
# rather than the extra's side effect. With the extra absent the check reports itself skipped
# and the plan says so. Every navigation passes the scope gate before the request, and the
# browser reaches the network only through ARACHNE's scope-bound proxy.
ARACHNE_WEB_BROWSER_CRAWL=false
# The crawl's documented budget, enforced in the walk loop and printed in the plan:
# MAX_PAGES counts navigations (each route is loaded once per marker source, so 25 covers 12
# routes), TIME_BUDGET_S bounds the whole crawl and TIMEOUT_S bounds one navigation.
ARACHNE_WEB_BROWSER_MAX_PAGES=25
ARACHNE_WEB_BROWSER_TIME_BUDGET_S=120.0
ARACHNE_WEB_BROWSER_TIMEOUT_S=20.0

# ---- misconfiguration & exposure checks (S7: M4) --------------------------------------
# M4 is path probing, so the bounds exist to keep one check from becoming a sweep: each
# check probes at most MAX_PATHS paths and reports at most MAX_FINDINGS candidates.
ARACHNE_M4_MAX_PATHS=60
ARACHNE_M4_MAX_FINDINGS=8
# `m4.bucket-exposure`: how many bucket-name candidates to derive from a declared domain.
ARACHNE_M4_MAX_BUCKET_NAMES=8
# `m4.default-credentials` is off at three levels: it is enabled_by_default=False, it needs
# `--active-checks` + an attestation, and this switch must also be on. When on, it tries ONE
# vendor-default pair per detected product, paced, and reports existence only (never a spray).
ARACHNE_M4_DEFAULT_CREDENTIALS=false
ARACHNE_M4_DEFAULT_CREDS_PACING_S=1.5
ARACHNE_M4_DEFAULT_CREDS_MAX_ATTEMPTS=3
# `m4.metadata-ssrf` is off by default too: with it off the check reports the SSRF sinks it
# can see in the crawl and never contacts a link-local address.
ARACHNE_M4_METADATA_SSRF=false
# Managed data (F-09-04): a file or directory replacing the shipped M4 probe corpus
# (probes.yaml + wordlists/).
# ARACHNE_M4_PROBES=/etc/arachne/m4

# ---- operator secrets ledger (S7: F-08-04) --------------------------------------------
# Evidence is redacted at capture time; this sidecar gives the operator the *masked*
# fingerprints (which credential shape, where, found by which check) so they know what to
# rotate. Unset MANIFEST means no ledger is written at all. Setting a path REQUIRES a key:
# the writer refuses to produce an unencrypted manifest.
# ARACHNE_SECRETS_MANIFEST=/var/lib/arachne/secrets.manifest
# ARACHNE_SECRETS_MANIFEST_KEY=...   (passphrase; scrypt-derived key, encrypt-then-MAC)
ARACHNE_SECRETS_MANIFEST_MAX=500

# ---- report engine (S8: F-06-*) -------------------------------------------------------
# Findings below MIN_CONFIDENCE are reported in section 9 as low-confidence observations,
# never mixed with confirmed findings. This is a *report* setting: the analyzer keeps its
# own ARACHNE_MIN_CONFIDENCE.
ARACHNE_REPORT_MIN_CONFIDENCE=55
# Evidence bodies are truncated at this many characters in a report (spec 06- §5, 8 KB).
# The full capture is still hashed and its sha256 appears beside the excerpt.
ARACHNE_REPORT_EVIDENCE_LIMIT=8192
ARACHNE_REPORT_LOW_CONFIDENCE=true
# Managed data (F-09-04): replace the CWE→OWASP Top-10 map and the executive-summary corpus.
# ARACHNE_REPORT_OWASP_MAP=/etc/arachne/owasp-map.yaml
# ARACHNE_REPORT_SUMMARY=/etc/arachne/executive-summary.yaml

# ---- AI integration layer (S9: F-04-*) ---------------------------------
# The AI engine is OPTIONAL and EXPLICIT: with nothing configured here, no scan ever contacts
# a model, and `--engine ai` fails with an actionable message instead of silently degrading
# (F-03-03). Provider *definitions* live in a file (api keys stay in the environment); the
# variables below are the one-provider shortcut and the policy knobs.
# ARACHNE_AI_CONFIG=/etc/arachne/ai.yaml
# ARACHNE_AI_PROVIDER=ollama
# ARACHNE_AI_BASE_URL=http://localhost:11434
# ARACHNE_AI_MODEL=qwen3:32b
# ARACHNE_AI_API_KEY_ENV=OPENAI_API_KEY
# The deployment's declared mode (a scan's own options.engine decides what actually runs).
ARACHNE_AI_ENGINE=hybrid
# local-only | redact (default) | default. `local-only` refuses non-local endpoints outright;
# `redact` tokenizes URLs/hosts/IPs/emails/credentials before anything leaves the process.
ARACHNE_AI_PRIVACY=redact
# Per-scan budget (F-04-07). 0 disables the respective gate. The ledger is persisted in the
# analysis step's statistics, so a report can say what a scan cost.
ARACHNE_AI_MAX_TOKENS_PER_SCAN=200000
ARACHNE_AI_MAX_COST_USD=1.50
# Which analysis stages run per candidate (comma-separated; triage pre/post).
ARACHNE_AI_STAGES=triage,explain,remediate,narrative
# Retry attempts per call, including the first (transient failures only: 429/5xx/network).
ARACHNE_AI_RETRIES=3
# A correlation group of at least this many candidates gets an AI title/reasoning.
ARACHNE_AI_CORRELATE_THRESHOLD=3
# Check ids/modules whose AI verdict replaces the deterministic one. EMPTY is the default:
# every check keeps its deterministic verdict so the finding set and verdicts stay
# reproducible . Add `m5.*`-style entries only for non-deterministic checks.
ARACHNE_AI_AUTHORITATIVE_CHECKS=
# Managed data and durability (F-09-04): prompt corpus, price table, and an on-disk analysis
# cache (a second scan in the same project reuses the first one's answers).
# ARACHNE_AI_PROMPTS=/etc/arachne/prompts
# ARACHNE_AI_PRICING=/etc/arachne/pricing.yaml
# ARACHNE_AI_CACHE_DIR=/var/lib/arachne/ai-cache

# ---- M3 extended web families (S10: research ch03#5-#34) -------------------------------
# The SSRF probe is the one M3 check that reaches a service *other than the target*: it needs
# a callback service on ARACHNE's own infrastructure AND its own switch on top of the
# active-checks gate. With neither set, `m3.ssrf-probe` reports itself skipped.
# ARACHNE_WEB_SSRF_CALLBACK=https://oob.arachne.example/callback
ARACHNE_WEB_SSRF_PROBE=false
# Bounded probe counts for the extended oracles (they must never become a fuzzing campaign).
ARACHNE_WEB_SMUGGLING_PROBES=4
ARACHNE_WEB_RACE_CONCURRENCY=8
ARACHNE_WEB_JWT_MAX_TOKENS=4
ARACHNE_WEB_GRAPHQL_BATCH=8
ARACHNE_WEB_TAKEOVER_NAMES=40

# ---- M5 cloud, container & supply chain (S10: F-02-06) --------------
# M5 is read-only and local-first. Repository/pipeline analysis reads a local clone only:
# declare `repo:/path/to/clone` (or `file:///path`) as a cloud target; a remote git URL is
# skipped rather than cloned.
# The metadata checks are off by default on top of the active-checks gate.
ARACHNE_M5_IMDS_PROBE=false
# Read-only validation (sts:GetCallerIdentity-class) of a key m5.leaked-cloud-keys found.
# Off by default; the call needs no IAM permission beyond the caller's own identity.
ARACHNE_M5_VALIDATE_CLOUD_KEYS=false
# Native container-image scanning (REQ-DET-016). On by default and needs nothing installed:
# the manifest and layers are fetched through the scoped client, unpacked only into a
# temporary directory and never executed. The caps below bound one image's cost; a layer
# over any of them is refused and reported.
ARACHNE_M5_IMAGE_SCAN=true
ARACHNE_M5_IMAGE_MAX_LAYERS=64
ARACHNE_M5_IMAGE_MAX_LAYER_BYTES=67108864
ARACHNE_M5_IMAGE_MAX_UNPACKED_BYTES=268435456
ARACHNE_M5_IMAGE_MAX_FILE_BYTES=33554432
ARACHNE_M5_IMAGE_MAX_MEMBERS=100000
# ARACHNE_M5_IMAGE_TEMP_DIR=/var/tmp/arachne
# External image scanner (Trivy/Grype class) — the opt-in path, never the default. The tool
# is not executed; set SBOM_REPORT to the JSON report it produced out of band and ARACHNE
# merges it into the native findings.
ARACHNE_M5_REGISTRY_SCAN=false
# ARACHNE_M5_SBOM_TOOL=trivy
# ARACHNE_M5_SBOM_REPORT=/var/lib/arachne/trivy-report.json
# ARACHNE_M5_IAC_TOOL=tfsec
ARACHNE_M5_DOCKER_SOCKET=true
# AWS read-only service posture (WP-31, REQ-DET-024). Declare the API base the
# least-privilege read-only role is scoped to as a cloud target, `aws-posture:<base>`,
# and store the role's static credential in the vault as an `aws-role` entry (access key
# id in the username, the secret in the secret, an optional session token in
# extra.session_token). The checks sign every request with SigV4 for this region and issue
# only the read actions ARACHNE declares; nothing is created, modified or deleted.
ARACHNE_M5_AWS_REGION=us-east-1
# How many resources one AWS posture check enumerates before it stops (a finding comes
# from the first page; the bound is what keeps one check from becoming an account dump).
ARACHNE_M5_AWS_MAX_RESOURCES=5
# Per-check bounds and the local-artifact read limits.
ARACHNE_M5_MAX_PATHS=40
ARACHNE_M5_MAX_FINDINGS=8
ARACHNE_M5_MAX_BUCKET_NAMES=8
ARACHNE_M5_MAX_FILE_BYTES=262144
ARACHNE_M5_MAX_REPO_FILES=4000
# Managed data (F-09-04): replace the M5 corpus/wordlists.
# ARACHNE_M5_PROBES=/etc/arachne/m5

# ---- M6 automation, AI-era & post-exploit signals (S11: F-02-07) -----
# M6 is file-read-only: the webshell/secret/CI scans read files, and nothing in M6 performs a
# post-exploitation action. Repository/log analysis reads local artifacts only — declare
# `repo:/path/to/clone` (or `file:///path`) as a cloud target.
# Telemetry checks require the explicit log-access grant below; without it the Sigma check
# ships the rule set and ingests nothing.
ARACHNE_M6_LOG_ACCESS=false
# ARACHNE_M6_LOG_PATHS=/var/log/arachne/events.jsonl,/var/lib/arachne/ci-logs
# The optional deception module (ch06#25) is off by default.
ARACHNE_M6_DECEPTION=false
# Offline-first EPSS/KEV enrichment (F-09-03): an operator may point these at a FIRST EPSS CSV,
# a CISA KEV JSON and an asset/version inventory export; the shipped snapshots are the default.
# ARACHNE_M6_EPSS_FEED=/var/lib/arachne/epss.csv
# ARACHNE_M6_KEV_FEED=/var/lib/arachne/kev.json
# ARACHNE_M6_RESOLVED_VERSIONS=/var/lib/arachne/versions.json
# Per-check bounds and the local-artifact read limits.
ARACHNE_M6_MAX_PATHS=40
ARACHNE_M6_MAX_FINDINGS=8
ARACHNE_M6_MAX_FILE_BYTES=262144
ARACHNE_M6_MAX_REPO_FILES=4000
ARACHNE_M6_WEBSHELL_PROBES=12
ARACHNE_M6_MAX_GIT_OBJECTS=200
# Managed data (F-09-04): replace the M6 corpus/wordlists/Sigma rules/LPE index.
# ARACHNE_M6_PROBES=/etc/arachne/m6
# ARACHNE_M6_SIGMA_RULES=/etc/arachne/sigma
# ARACHNE_M6_LPE_INDEX=/var/lib/arachne/lpe-index.yaml
# ARACHNE_M6_WEBSHELL_PATHS=/etc/arachne/webshell-paths.txt

# ---- Scheduler: recurring scans and change detection (S11: F-01-05) ---------------------
# `arachne schedule add|list|remove|run`. State (definitions + last/next run per schedule)
# lives in a JSON file; delete it to reset. Change detection persists a scans_diff row per run.
# ARACHNE_SCHEDULER_STATE=.arachne/schedules.json
ARACHNE_SCHEDULER_MAX_RUNS=4
ARACHNE_SCHEDULER_DIFF=true

# ---- REST API + Web UI (S12: F-07-02/03, F-08-02) ---------------------------------------
# `arachne serve` starts the JSON API (/api/v1) and the web UI (/ui) in one process.
# API keys are 'label:role:secret' entries (roles: viewer < scanner < admin), ';'-separated.
# With no keys configured the API refuses every request (closed by default). Prefer
# ARACHNE_API_KEYS_FILE (one entry per line) so secrets are not in the process environment.
# ARACHNE_API_KEYS=admin:admin:REPLACE_ME;ci:scanner:REPLACE_ME;ui:viewer:REPLACE_ME
# ARACHNE_API_KEYS_FILE=/run/secrets/arachne-api-keys
ARACHNE_API_HOST=127.0.0.1
ARACHNE_API_PORT=8080
# TLS is required to bind a non-loopback address (F-08-02); loopback may serve plain HTTP.
ARACHNE_API_REQUIRE_TLS=true
# ARACHNE_API_TLS_CERT=/etc/arachne/tls/cert.pem
# ARACHNE_API_TLS_KEY=/etc/arachne/tls/key.pem
# Per-identity API rate limit (token bucket; identity = API key, else client address).
ARACHNE_API_RATE_LIMIT=120
ARACHNE_API_RATE_BURST=30
# Public base URL, used to build the report link a webhook card carries.
# ARACHNE_API_BASE_URL=https://arachne.example
ARACHNE_API_DOCS=true
# Browser-origin allowlist (CORS); empty means same-origin only.
# ARACHNE_API_CORS_ORIGINS=https://arachne.example
# Host header allowlist; empty accepts the configured host and loopback names.
# ARACHNE_API_TRUSTED_HOSTS=arachne.example
ARACHNE_API_SESSION_MAX_AGE=43200
# uvicorn worker processes for `arachne serve` (S22, REQ-OPS-005). 1 = one process; the
# Helm chart scales pods for HA and uses this for per-pod CPU parallelism.
ARACHNE_API_WORKERS=1

# ---- Webhooks: scan-completion integrations (S12: F-06-06) ------------------------------
# Off by default; every endpoint is optional and every token is read from the environment.
# Slack/Teams get one summary card; Jira gets one issue per finding at/above min_severity;
# DefectDojo gets a JSON import; ServiceNow one incident per finding; the SIEM export
# posts findings + audit events as NDJSON. A failed delivery is audited and never fails
# the scan. (S22, area OPS: REQ-OPS-001/002.)
ARACHNE_WEBHOOKS_ENABLED=false
# ARACHNE_WEBHOOK_SLACK_URL=https://hooks.slack.com/services/...
# ARACHNE_WEBHOOK_TEAMS_URL=https://outlook.office.com/webhook/...
# ARACHNE_WEBHOOK_JIRA_URL=https://your-org.atlassian.net
# ARACHNE_WEBHOOK_JIRA_PROJECT=SEC
# ARACHNE_WEBHOOK_JIRA_USER=you@example.com          # omit for a bearer (PAT) token
# ARACHNE_WEBHOOK_JIRA_TOKEN=...
# ARACHNE_WEBHOOK_SERVICENOW_URL=https://your-instance.service-now.com
# ARACHNE_WEBHOOK_SERVICENOW_USER=svc-arachne        # required together with the URL
# ARACHNE_WEBHOOK_SERVICENOW_PASSWORD=...
# ARACHNE_WEBHOOK_DEFECTDOJO_URL=https://defectdojo.example
# ARACHNE_WEBHOOK_DEFECTDOJO_TOKEN=...
# ARACHNE_WEBHOOK_SIEM_URL=https://siem.example:8443/collector
# ARACHNE_WEBHOOK_SIEM_TOKEN=...                    # optional bearer
ARACHNE_WEBHOOK_MIN_SEVERITY=high
ARACHNE_WEBHOOK_MAX_FINDINGS=25
ARACHNE_WEBHOOK_TIMEOUT_S=10
# Managed-data override for the card/issue templates (F-09-04).
# ARACHNE_WEBHOOK_TEMPLATES=/etc/arachne/webhooks

# ---- CI gate (S12: F-07-05) -------------------------------------------------------------
# `arachne scan --fail-on NAME` (or this variable) makes a scan exit 2 when a finding is at
# or above NAME, 1 when findings exist below it, 0 when clean. 'none' disables the gate.
# ARACHNE_CI_FAIL_ON=high

# ---- Multi-tenancy: projects / workspaces (S14: F-07-06) --------------------------------
# A tenant is a row in `projects` with its own scope and report branding. The CLI/API select
# one per command/request: `arachne scan --project acme`, `X-Project: acme`, `?project=acme`.
# API keys may be bound to a tenant with a fourth field:
#   ARACHNE_API_KEYS='acme-admin:admin:<secret>:acme'
# A bound key can only see and scan its own project. Rows written before S14 (project_id
# NULL) belong to the `default` workspace, which always exists and cannot be deleted.
# ARACHNE_DATABASE_PASSWORD_FILE=/run/secrets/postgres_password   # docker secret; injected
#                                                                 # into ARACHNE_DATABASE_URL
#   Example: ARACHNE_DATABASE_URL=postgresql+psycopg://arachne@db:5432/arachne
#   (install the driver: pip install "arachne[postgres]"; needs psycopg)

# ---- CVE/EPSS feed ingestion (S14: F-09-03) ---------------------------------------------
# Offline ingestion of a FIRST EPSS CSV, a CISA KEV JSON or a CVE JSON/YAML snapshot:
#   arachne feeds import <file>      (also: POST /api/v1/feeds, or the web UI at /ui/feeds)
# Normalised artefacts are written under feeds.dir (default: beside the SQLite database) and
# the newest feed of each kind is used by the next scan automatically — no other setting.
# ARACHNE_FEEDS_DIR=/var/lib/arachne/feeds
ARACHNE_FEEDS_MAX_ENTRIES=50000

# ---- Plugins (S14: F-09-01) -------------------------------------------------------------
# Install a check or report-format plugin from a local path or git URL:
#   arachne plugin install ./my-plugin            (or git+https://... / git@host:repo.git)
# Installation over the API (`POST /api/v1/plugins/install`) is REFUSED unless enabled here:
ARACHNE_PLUGIN_INSTALL=false
# Managed-data override for the marketplace catalogue (default: the bundled index).
# ARACHNE_MARKETPLACE=/etc/arachne/marketplace.yaml
ARACHNE_PLUGIN_TIMEOUT_S=600

# ---- White-label report branding (S14, MSSP) --------------------------------------------
# A YAML/JSON document applied to every format (md/html/json/pdf). A project's `branding`
# overrides these field by field. Colours are hex; the logo must be http(s) or data:image.
# ARACHNE_REPORT_BRANDING=/etc/arachne/branding.yaml
#   company_name: Acme Security
#   product_name: ARACHNE
#   tagline: Managed detection & response
#   primary_color: "#1f4e79"
#   accent_color: "#c00000"
#   logo_url: https://acme.example/logo.png
#   logo_text: AC
#   footer_text: Prepared for Acme Corp
#   contact: soc@acme.example
#   classification: CONFIDENTIAL
#   show_arachne_branding: false

# ---- Live threat intel: feed sync (S18, REQ-INTEL-001/002) -------------------------------
# Off by default. With this on, `arachne intel sync` fetches NVD API 2.0, the CISA KEV
# catalogue and FIRST EPSS incrementally and imports them through the same store
# `arachne feeds import` writes to (the next scan uses them with no further change).
ARACHNE_INTEL_ENABLED=false
# Sources a sync fetches when none is named on the command line.
ARACHNE_INTEL_FEED_SOURCES=nvd,kev,epss

# Verification is MANDATORY: a feed is imported only if it verifies, and a source with no
# pinned expectation is refused (never imported unverified). `checksum` compares the
# payload's SHA-256 with a pin; `signature` verifies a detached RSA PKCS#1 v1.5/SHA-256
# signature against the public key below (use it when you mirror and sign the feeds).
ARACHNE_INTEL_FEED_VERIFY=checksum
# Inline pins, or a manifest file ({"kev": "sha256:..."} / `name=sha256:...` lines).
# ARACHNE_INTEL_FEED_CHECKSUMS="nvd=sha256:...,kev=sha256:...,epss=sha256:..."
# ARACHNE_INTEL_FEED_CHECKSUMS_FILE=/etc/arachne/intel-checksums.json
# ARACHNE_INTEL_FEED_PUBLIC_KEY=/etc/arachne/intel-signing.pub.pem
# `arachne intel sync --pin` records the digests of a fetch you have decided to trust.
#   (audited as `intel.checksums_pinned`; every later sync is fail-closed)

# Bounds and politeness. NVD asks for at most one request per 6 s without a key.
ARACHNE_INTEL_MAX_BYTES=67108864
ARACHNE_INTEL_MAX_PAGES=20
ARACHNE_INTEL_REQUEST_DELAY_S=6
# ARACHNE_NVD_API_KEY=...
# Hours per feed kind after which the report marks it stale.
# ARACHNE_INTEL_FRESHNESS_TTL="nvd=168,kev=168,epss=48,cve=720"
# Which feed kinds move a finding's severity (WP-21, REQ-INTEL-006). A feed in this list
# that is past its TTL produces a visible warning in the report metadata; every feed still
# appears with its timestamp and age. The default is EPSS (score band) and KEV (known
# exploitation); add nvd/cve if your scoring depends on their CVSS.
# ARACHNE_INTEL_SEVERITY_FEEDS=epss,kev
# Replay recorded responses instead of fetching (offline demos/tests):
# ARACHNE_INTEL_FIXTURES=/etc/arachne/intel-fixtures

# ---- The two-layer CVE index (S18, REQ-INTEL-001) ---------------------------------------
# The index a scan reads is a GENERATED baseline merged with the curated overlay
# (ARACHNE_CVE_INDEX), and the overlay wins on a repeated (product, cve).
#   `arachne intel build-index --output <file>` regenerates the baseline from the synced
#   NVD corpus for the products in the product map below.
# ARACHNE_CVE_INDEX_BASELINE=/etc/arachne/cve-index-baseline.yaml     (or `off`)
# ARACHNE_CVE_INDEX_PRODUCTS=/etc/arachne/cve-index-products.yaml
ARACHNE_CVE_INDEX_MAX_ENTRIES=500

# ---- Passive OSINT providers (S18, REQ-INTEL-003/005) ----------------------------------
# Strictly opt-in, twice over: the provider must be named in ARACHNE_OSINT_PROVIDERS (none
# of the five below is enabled by the osint defaults) AND its check must be selected.
# A provider whose credential is missing is dropped from the scope and disabled, so a
# half-configured provider is a skip with a reason — never an unauthenticated request.
# Credentials are read from the environment only and are redacted from every record.
# ARACHNE_SHODAN_API_KEY=...              # m1.service-exposure-drift
# ARACHNE_CENSYS_API_ID=...               # m1.service-exposure-drift (needs both halves)
# ARACHNE_CENSYS_API_SECRET=...
# ARACHNE_HIBP_API_KEY=...                # m1.breach-exposure
# RDAP base for the `whois` provider (m1.ct-surprise). Referrals to other RDAP hosts are
# refused unless that host is in ARACHNE_OSINT_EXTRA_HOSTS.
# ARACHNE_OSINT_WHOIS_URL=https://rdap.org/domain/{query}
# Per-provider pacing, requests/second, on top of the shared per-host limiter.
# ARACHNE_OSINT_PROVIDER_RATE_LIMITS="shodan=1.0,censys=0.5,hibp=0.5,certspotter=1.0,whois=1.0"
# Days back a certificate counts as a "surprise" in m1.ct-surprise.
ARACHNE_OSINT_CT_WINDOW_DAYS=14

# ---- Credential vault (S19, area CREDS: REQ-CREDS-001/002/003) -------------------------
# The vault is a NODE-LOCAL encrypted file (scrypt + SHAKE-256 keystream + HMAC-SHA256, the
# same construction as the secrets manifest, under its own magic). Unset = no vault: a scan
# that names a credential runs unauthenticated and the refusal is audited
# (credential.unresolved). A path without a key is refused — never a plaintext fallback.
# Manage it with `arachne vault put|list|show|revoke|remove`; the secret is read from
# ARACHNE_VAULT_SECRET (or --secret-env VAR) or a hidden prompt, never from argv.
# ARACHNE_VAULT_PATH=/etc/arachne/credentials.enc
# ARACHNE_VAULT_KEY=...              (passphrase; required when ARACHNE_VAULT_PATH is set)
ARACHNE_VAULT_MAX_ENTRIES=256

# ---- Internal agent mode (S19, REQ-CREDS-003) -----------------------------------------
# `internal` marks an agent deployed inside the target network: it resolves credential
# labels against ITS OWN vault after leasing, and no credential material crosses the control
# plane (only labels do). No gate is relaxed — scope, attestation and proof are re-run on the
# executing node either way. See operator guide §22.
# ARACHNE_AGENT_MODE=internal

# ---- Data lifecycle: retention & the pruning job (S20, area DATA: REQ-DATA-001) ---------
# A per-project policy (`projects.retention_json`) overrides these per category; 0 means
# KEEP FOR EVER, and `enabled: false` on a project is a legal hold (the job plans nothing and
# deletes nothing for it). `arachne retention status|plan|prune` — prune is a DRY RUN unless
# --apply is given, and both paths write an audit line. Audit is deployment-wide (audit_log
# has no project column): the smallest non-zero audit_days among the policies wins.
ARACHNE_RETENTION_ENABLED=true
ARACHNE_RETENTION_FINDINGS_DAYS=365
ARACHNE_RETENTION_EVIDENCE_DAYS=180
ARACHNE_RETENTION_SCANS_DAYS=90
ARACHNE_RETENTION_AUDIT_DAYS=730
# Rows per category per run, so a first prune is a series of repeatable batches.
ARACHNE_RETENTION_BATCH_LIMIT=10000

# ---- Evidence storage backend (S20, REQ-DATA-002/003/004) -------------------------------
# Evidence stays INLINE in the database below the threshold; above it the payload goes to the
# backend and the row keeps a stub (scalars + a bounded preview + the object's key/sha256).
# Objects are content-addressed (the key IS the sha256), so identical payloads are stored
# once, and zlib-compressed. A payload whose stub would be bigger than itself stays inline.
ARACHNE_EVIDENCE_BACKEND=local          # local | s3
# ARACHNE_EVIDENCE_DIR=/var/lib/arachne/evidence   (default: beside the database)
ARACHNE_EVIDENCE_OFFLOAD_THRESHOLD_BYTES=16384
ARACHNE_EVIDENCE_PREVIEW_CHARS=2048
ARACHNE_EVIDENCE_COMPRESS=true
ARACHNE_EVIDENCE_COMPRESS_LEVEL=6
ARACHNE_EVIDENCE_DEDUP=true
# Presigned download URL lifetime (seconds) for object-store backends.
ARACHNE_EVIDENCE_PRESIGN_TTL_S=900
# Per-project quota: warn at the ratio, then refuse the write (nothing is stored, the scan
# fails with a `quota.exceeded` audit line, and `arachne scan --resume` continues it once the
# quota is raised). 0/unset = no quota. `arachne retention quota --project <slug> --bytes <n>`.
# ARACHNE_EVIDENCE_DEFAULT_QUOTA_BYTES=53687091200
ARACHNE_EVIDENCE_QUOTA_WARN_RATIO=0.8
# S3-compatible backend (MinIO, Ceph RGW, AWS S3). STATIC credentials only, and all three of
# endpoint/bucket/access key/secret are required when ARACHNE_EVIDENCE_BACKEND=s3: a
# half-configured object store is a configuration error, never a silent local fallback.
# ARACHNE_EVIDENCE_S3_ENDPOINT=https://s3.example.com
# ARACHNE_EVIDENCE_S3_BUCKET=arachne-evidence
# ARACHNE_EVIDENCE_S3_REGION=us-east-1
# ARACHNE_EVIDENCE_S3_PREFIX=evidence
# ARACHNE_EVIDENCE_S3_ACCESS_KEY=...
# ARACHNE_EVIDENCE_S3_SECRET_KEY=...
# ARACHNE_EVIDENCE_S3_SESSION_TOKEN=...            (optional, for temporary credentials)
ARACHNE_EVIDENCE_S3_PATH_STYLE=true
# A MinIO/collector on a private address needs this, exactly like an internal agent does.
ARACHNE_EVIDENCE_S3_ALLOW_PRIVATE_IPS=false

# ---- Agentic reasoning (S21, area AGENT: REQ-AGENT-001...007) --------------------------
# The hypothesis engine is OFF by default: a deployment that never opts in runs exactly the
# pre-S21 pipeline (no hypothesis step, no extra request, no extra audit line).
# off | heuristic | hybrid | ai
ARACHNE_HYPOTHESES=off
# The per-scan budget: how many hypotheses may run, and what they may cost in planned requests.
ARACHNE_HYPOTHESIS_MAX=5
ARACHNE_HYPOTHESIS_MAX_PROBES=50
# Proposals one reasoning pass may return (bounds a hostile input).
ARACHNE_HYPOTHESIS_MAX_PROPOSALS=32
ARACHNE_HYPOTHESIS_VERIFY_BELOW=70
# The operator kill switch's file (REQ-AGENT-007), read by a scan between two hypotheses —
# possibly on another node, which is why it is a file both sides can reach.
ARACHNE_HYPOTHESIS_CONTROL=.arachne/hypothesis-control.json
# Optional JSONL mirror of every hypothesis journal (the journal already lives with the scan).
# ARACHNE_HYPOTHESIS_JOURNAL=.arachne/hypotheses.jsonl

# ---- Compliance frameworks (S22, area TRUST: REQ-TRUST-001) -----------------------------
# Frameworks every report maps its findings onto (comma list): cis, pci-dss, iso27001,
# nist-csf. Empty = no framework section (a pre-S22 report, byte for byte). The maps are
# data files; a deployment can override them with its own directory.
# ARACHNE_REPORT_COMPLIANCE_FRAMEWORKS=iso27001,pci-dss
# ARACHNE_REPORT_COMPLIANCE_MAPS=/etc/arachne/compliance
# The audit-ready per-control evidence export is a command, not a setting:
#   arachne compliance export --scan 7 --framework iso27001 -o evidence.json

# ---- Metrics and traces (S20, area OPS: REQ-OPS-003/004) --------------------------------
# GET /metrics (Prometheus text). Aggregate only — no target, asset, finding or payload —
# and public like /health unless a token is set. Point Prometheus at EVERY worker: the
# counters are per-process, the gauges are read from the database at scrape time.
ARACHNE_METRICS_ENABLED=true
# ARACHNE_METRICS_TOKEN=...            (bearer token; unset = no authentication)
# OpenTelemetry traces: opt-in, sampled, best-effort. One span per pipeline step plus one per
# HTTP request, with the W3C traceparent propagated outbound. An unreachable collector is
# logged and dropped; it never fails a scan.
ARACHNE_TRACING_ENABLED=false
ARACHNE_TRACING_SAMPLE_RATIO=0.1
# ARACHNE_OTLP_ENDPOINT=https://otel-collector.example.com:4318
ARACHNE_OTLP_TIMEOUT_S=10.0
ARACHNE_OTLP_SERVICE_NAME=arachne
ARACHNE_OTLP_ALLOW_PRIVATE_IPS=false

# ---------------------------------------------------------------- S23 — continuous exposure management
# The continuous cloud-config check (m5.cloud-posture) reads a state snapshot with one bounded
# read-only GET per configured path. ARACHNE_M5_POSTURE_TOKEN is the optional bearer credential
# the snapshot endpoint needs (environment only; never logged, never stored).
# ARACHNE_M5_POSTURE_TOKEN=...
ARACHNE_M5_POSTURE_MAX_RESOURCES=200
ARACHNE_M5_POSTURE_MAX_BYTES=1048576
# Continuous-schedule cost guardrails (risk R-13): a continuous schedule without its own budget
# inherits these. A run past either cap is refused and audited (schedule.budget_refused).
ARACHNE_POSTURE_MAX_RUNS_PER_DAY=24
ARACHNE_POSTURE_MAX_REQUESTS=5000
# Kubernetes admission posture (REQ-POSTURE-005): monitor is the default — evaluate, record,
# always allow. enforce denies only inside the staged namespace list (use "*" deliberately);
# off makes the route refuse. The deny threshold is on the severity ladder.
ARACHNE_ADMISSION_MODE=monitor
# ARACHNE_ADMISSION_ENFORCE_NAMESPACES=staging
ARACHNE_ADMISSION_DENY_ON=high
# CMDB import bounds (arachne posture cmdb import).
ARACHNE_POSTURE_CMDB_MAX_ROWS=10000
ARACHNE_POSTURE_CMDB_MAX_BYTES=4194304

# --------------------------------------------------------------------------- S24 (VALID)
# Detection validation (purple team). Tests are designed to be SEEN: payloads are emitted
# verbatim inside the coordinated detection window, tagged with the run nonce, under the
# ordinary rate limit. A run outside its window is refused and audited.
# SIEM pull ingest: when set, a campaign run collects the window's alerts from this endpoint
# through the shared scoped HTTP client (pinned to its host). Unset = webhook/export only.
# ARACHNE_PURPLE_ALERTS_URL=https://siem.example.com/api/alerts
# Bearer for the pull endpoint — environment only, never logged or written to a scan.
# ARACHNE_PURPLE_ALERTS_TOKEN=
# Bounds: proof actions one run may replay, alerts one ingest accepts, run-nonce entropy.
ARACHNE_PURPLE_MAX_ACTIONS=12
ARACHNE_PURPLE_MAX_ALERTS=1000
ARACHNE_PURPLE_NONCE_BYTES=12
# Override the shipped ATT&CK replay catalogue (which actions are replayable, and the
# telemetry each one emits). The map is cross-checked against the module catalogue.
# ARACHNE_PURPLE_MAP=/etc/arachne/attck-map.yaml

# --------------------------------------------------------------------------- S25 (RESIL/TRUST)
# Tamper-evidence (REQ-TRUST-005). ARACHNE_INTEGRITY_KEY is the deployment key that signs the
# audit chain heads, every finding/evidence row and every scan seal. It is optional: without it
# the hash chain still exists and still detects an edited row, but `arachne verify-chain
# --require-signatures` refuses to report "intact" — absence is a refusal, not a pass. Keep this
# key out of band from the database: it is what makes a rewritten row detectable.
# ARACHNE_INTEGRITY_KEY=<32+ random characters>
# ARACHNE_INTEGRITY_KEY_FILE=/run/secrets/arachne-integrity-key
# Non-secret label carried in every signature (defaults to a digest of the key).
# ARACHNE_INTEGRITY_KEY_ID=prod-2026-10
# Seal a scan when it completes (what makes a *deleted* finding or evidence row detectable).
ARACHNE_INTEGRITY_SEAL=true
# Treat an unsigned chain/row/seal as a verification failure rather than a note.
ARACHNE_INTEGRITY_REQUIRE_SIGNATURES=false
# Auto-anchor the chain every N audit rows (0 = only the explicit `arachne integrity anchor`).
# Export an anchor off-host as well: an anchor kept only in the database it guards can be
# deleted along with the evidence of the deletion.
ARACHNE_INTEGRITY_ANCHOR_EVERY=1000

# Asymmetric signing (REQ-TRUST-008). With HMAC the verifier and the signer are the same party,
# so an auditor who must not be able to forge cannot verify. Setting the algorithm to `ed25519`
# makes the deployment sign with an asymmetric key — an auditor holding *only* the public half
# verifies the chain, the row signatures and the seals, and cannot make one.
#
#   ARACHNE_INTEGRITY_ALGORITHM=hmac          (default) | ed25519
#   ARACHNE_INTEGRITY_ED25519_KEY             the private half: a 32-byte seed, hex (64 chars) or
#                                             base64. Generate a pair with:
#                                               python -c "from arachne.core.signing import generate_keypair; \
#                                                 print('\n'.join(generate_keypair()))"
#   ARACHNE_INTEGRITY_ED25519_KEY_FILE        ...or read the seed from a file (docker/Helm secret)
#   ARACHNE_INTEGRITY_ED25519_PUBLIC_KEY      the public half: what you hand an auditor
#   ARACHNE_INTEGRITY_ED25519_KEY_ID          optional non-secret label (defaults to a digest of
#                                             the public key)
#
# DUAL PERIOD: to migrate, set the algorithm to ed25519 *and keep ARACHNE_INTEGRITY_KEY set*.
# New rows are signed with Ed25519 and every row and anchor written before the switch still
# verifies, because `arachne verify-chain` verifies with both keys. Drop the HMAC key once
# retention has passed the last pre-switch row — the cutover is a retention decision, not a
# flag day (docs/adr/370-trust-hardening-and-purple-breadth.md).
#
# An auditor runs with ARACHNE_INTEGRITY_ALGORITHM=ed25519 and only the PUBLIC key set: that
# deployment verifies and refuses to sign, which is the point.
# ARACHNE_INTEGRITY_ALGORITHM=ed25519
# ARACHNE_INTEGRITY_ED25519_KEY_FILE=/run/secrets/arachne-integrity-ed25519-seed
# ARACHNE_INTEGRITY_ED25519_PUBLIC_KEY=<64 hex characters>
# The implementation is NOT constant-time: keep the seed off hosts you do not trust against a
# local timing attacker.

# Air-gapped mode (REQ-RESIL-001). The only reachable hosts become the deployment's scan
# targets (ARACHNE_SCOPE_*) plus ARACHNE_AIRGAP_ALLOWED_HOSTS. Everything else — feeds, OSINT
# providers, cloud AI, webhooks, an OTLP collector, an IdP — is refused at the shared client
# and audited (`airgap.blocked`). NOTE: with no ARACHNE_SCOPE_* set, *every* host is refused,
# including your scan targets: declare the estate you are authorized to scan.
ARACHNE_AIRGAPPED=false
# ARACHNE_AIRGAP_ALLOWED_HOSTS=ollama.internal,feed-mirror.internal
# Where imported offline content packs are unpacked (default: <db dir>/content).
# ARACHNE_CONTENT_DIR=/var/lib/arachne/content
# Refuse an unsigned content pack on import (the fail-closed default; `--allow-unsigned` is
# the explicit, audited exception for a lab).
ARACHNE_CONTENT_REQUIRE_SIGNATURE=true

# Multi-region evidence residency (REQ-RESIL-004). Declare this deployment's region; evidence
# written here is stamped with it, and a project may pin its own (projects.residency_region).
# A cross-region read is refused (residency.rejected) — inline payloads included.
# ARACHNE_REGION=eu-west-1

# PII in captured evidence (REQ-TRUST-006). Masked at capture, before the quota check, any
# offload and any row — so a masked value cannot reach the database, an object store, a report,
# a log or the audit trail. Off by default, because masking is irreversible.
ARACHNE_PII_ENABLED=false
ARACHNE_PII_CATEGORIES=email,phone,ssn,credit-card,iban,ipv4
ARACHNE_PII_ACTION=mask
# ARACHNE_PII_SALT=<random>            # required when ARACHNE_PII_ACTION=hash
# Re-mask evidence older than this in the retention prune run (0 = mask at capture only).
ARACHNE_PII_RETENTION_DAYS=0

# Scan-farm autoscaling and the HA leader lease (REQ-RESIL-002/003). The Kubernetes objects
# that act on these numbers ship in the Helm chart (`autoscaling:` in values.yaml); the values
# here are what `arachne dr status` prints and what the metrics expose.
ARACHNE_AUTOSCALE_QUEUE_DEPTH_PER_REPLICA=4
ARACHNE_AUTOSCALE_MIN_REPLICAS=0
ARACHNE_AUTOSCALE_MAX_REPLICAS=8
ARACHNE_LEADER_TTL_S=30

# --------------------------------------------------------------------------- S26 (ECOS)
# Content-pack marketplace review (REQ-ECOS-001). With require_review on (the default) a pack
# import is refused unless a *listed* verdict exists for the pack's exact digest — run
# `arachne plugin review <pack> --publish` first (ARACHNE_INTEGRITY_KEY signs and verifies the
# pack). A review is a policy gate, not a sandbox: it raises the cost of shipping a hostile pack
# and makes the honest mistake loud; the pack still runs in-process once listed.
ARACHNE_PLUGIN_REQUIRE_REVIEW=true
# Accept an unsigned pack in review. A lab-only escape hatch, off by default and audited.
ARACHNE_PLUGIN_ALLOW_UNSIGNED=false

# Report language and white-label/MSSP mode (REQ-ECOS-005/006). ARACHNE_REPORT_LOCALE is the
# deployment default report language (a BCP-47 tag such as fr); a report may override it with
# --locale / ?locale=, and a project with its own stored locale overrides it for that tenant. An
# unknown locale falls back to English rather than failing. Only the report's structural labels
# are translated (section headings, severity names, labels) — the narrative prose stays English.
# ARACHNE_REPORT_LOCALE=fr
# Force white-label/MSSP presentation deployment-wide: the product name falls back to the
# tenant's company name and the ARACHNE attribution is hidden. A *deployment* setting — a tenant
# cannot switch it back on; per-tenant branding (projects.branding_json) is unchanged.
ARACHNE_REPORT_WHITE_LABEL=false

# --------------------------------------------------------------------------- S28 (SIM)
# Simulation & what-if modeling (REQ-SIM-001...006). The engine is structurally offline: it
# imports no HTTP client and no socket, and every run installs a runtime guard that denies the
# socket entry points and fails closed (a blocked `simulation.boundary_violation` audit event).
# There is deliberately no URL, host or timeout setting here — a simulation computes over stored
# scan data and has no request to configure.
#
# Bounds on one what-if / change run. A run is bounded for the same reason a report section is:
# "what if every host were exposed?" must produce a readable answer, not an unbounded search.
ARACHNE_SIM_MAX_HYPOTHESES=32
ARACHNE_SIM_MAX_PATHS=25
# The verified-hop threshold, mirroring the report's own (analyzer.paths.DEFAULT_MIN_CONFIDENCE).
ARACHNE_SIM_MIN_CONFIDENCE=55
# Opt in to event-driven re-simulation (REQ-SIM-006): a finished scan (or a ready report) rebuilds
# the estate model, re-runs the simulation and appends a point to the simulation trend the posture
# view renders. Off by default, like every continuous capability; a failure here is a counted
# error and never a failed scan.
ARACHNE_SIM_RESIMULATE=false
ARACHNE_SIM_TREND_LIMIT=50
