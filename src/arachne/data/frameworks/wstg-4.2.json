    {"id": "WSTG-SESS-08", "category": "SESS", "number": 8, "title": "Testing for Session Puzzling"},
    {"id": "WSTG-SESS-09", "category": "SESS", "number": 9, "title": "Testing for Session Hijacking"},
    {"id": "WSTG-INPV-01", "category": "INPV", "number": 1, "title": "Testing for Reflected Cross Site Scripting"},
