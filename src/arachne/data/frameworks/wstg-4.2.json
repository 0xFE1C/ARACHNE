    {"id": "WSTG-CLNT-01", "category": "CLNT", "number": 1, "title": "Testing for DOM-Based Cross Site Scripting"},
    {"id": "WSTG-CLNT-02", "category": "CLNT", "number": 2, "title": "Testing for JavaScript Execution"},
