{
  "framework": "WSTG",
  "version": "4.2",
  "title": "OWASP Web Security Testing Guide",
  "source": "https://owasp.org/www-project-web-security-testing-guide/v42/",
  "id_pattern": "^WSTG-(?:INFO|CONF|IDNT|ATHN|ATHZ|SESS|INPV|ERRH|CRYP|BUSL|CLNT|APIT)-\\d{2}$",
  "notes": "The 97 test IDs of WSTG v4.2 (12 categories). 'scope' is the counting rule: an in-scope item is one a black-box or credentialed scanner can produce evidence about; an out_of_scope item needs source access, a human interview or organisational process and carries a reason. A check maps to the item whose test procedure its evidence bears on. This snapshot is vendored so the ledger needs no network (risk A-02).",
  "items": [
    {"id": "WSTG-INFO-01", "category": "INFO", "number": 1, "title": "Conduct Search Engine Discovery Reconnaissance for Information Leakage"},
    {"id": "WSTG-INFO-02", "category": "INFO", "number": 2, "title": "Fingerprint Web Server"},
    {"id": "WSTG-INFO-03", "category": "INFO", "number": 3, "title": "Review Webserver Metafiles for Information Leakage"},
    {"id": "WSTG-INFO-04", "category": "INFO", "number": 4, "title": "Enumerate Applications on Webserver"},
    {"id": "WSTG-INFO-05", "category": "INFO", "number": 5, "title": "Review Webpage Comments and Metadata for Information Leakage"},
    {"id": "WSTG-INFO-06", "category": "INFO", "number": 6, "title": "Identify Application Entry Points"},
    {"id": "WSTG-INFO-07", "category": "INFO", "number": 7, "title": "Map Execution Paths Through Application"},
    {"id": "WSTG-INFO-08", "category": "INFO", "number": 8, "title": "Fingerprint Web Application Framework"},
    {"id": "WSTG-INFO-09", "category": "INFO", "number": 9, "title": "Fingerprint Web Application"},
    {"id": "WSTG-INFO-10", "category": "INFO", "number": 10, "title": "Map Application Architecture"},
    {"id": "WSTG-CONF-01", "category": "CONF", "number": 1, "title": "Test Network Infrastructure Configuration"},
    {"id": "WSTG-CONF-02", "category": "CONF", "number": 2, "title": "Test Application Platform Configuration"},
    {"id": "WSTG-CONF-03", "category": "CONF", "number": 3, "title": "Test File Extensions Handling for Sensitive Information"},
    {"id": "WSTG-CONF-04", "category": "CONF", "number": 4, "title": "Review Old Backup and Unreferenced Files for Sensitive Information"},
    {"id": "WSTG-CONF-05", "category": "CONF", "number": 5, "title": "Enumerate Infrastructure and Application Admin Interfaces"},
    {"id": "WSTG-CONF-06", "category": "CONF", "number": 6, "title": "Test HTTP Methods"},
    {"id": "WSTG-CONF-07", "category": "CONF", "number": 7, "title": "Test HTTP Strict Transport Security"},
    {"id": "WSTG-CONF-08", "category": "CONF", "number": 8, "title": "Test RIA Cross Domain Policy", "scope": "out_of_scope", "reason": "Adobe Flash and Microsoft Silverlight are end-of-life; there is no RIA runtime left to exercise a cross-domain policy file against."},
    {"id": "WSTG-CONF-09", "category": "CONF", "number": 9, "title": "Test File Permission", "scope": "out_of_scope", "reason": "Reading host file modes needs filesystem access to the server; a remote scanner cannot observe them."},
    {"id": "WSTG-CONF-10", "category": "CONF", "number": 10, "title": "Test for Subdomain Takeover"},
    {"id": "WSTG-CONF-11", "category": "CONF", "number": 11, "title": "Test Cloud Storage"},
    {"id": "WSTG-IDNT-01", "category": "IDNT", "number": 1, "title": "Test Role Definitions", "scope": "out_of_scope", "reason": "Requires the application's documented role model or source access; a black-box scan observes behaviour, not role definitions."},
    {"id": "WSTG-IDNT-02", "category": "IDNT", "number": 2, "title": "Test User Registration Process", "scope": "out_of_scope", "reason": "An organisational process (how registration is approved); verifying it needs a human interview or internal documentation."},
    {"id": "WSTG-IDNT-03", "category": "IDNT", "number": 3, "title": "Test Account Provisioning Process", "scope": "out_of_scope", "reason": "An organisational process (how accounts are provisioned); a remote scan cannot observe it."},
    {"id": "WSTG-IDNT-04", "category": "IDNT", "number": 4, "title": "Testing for Account Enumeration and Guessable User Account"},
    {"id": "WSTG-IDNT-05", "category": "IDNT", "number": 5, "title": "Testing for Weak or Unenforced Username Policy"},
    {"id": "WSTG-ATHN-01", "category": "ATHN", "number": 1, "title": "Testing for Credentials Transported over an Encrypted Channel"},
    {"id": "WSTG-ATHN-02", "category": "ATHN", "number": 2, "title": "Testing for Default Credentials"},
    {"id": "WSTG-ATHN-03", "category": "ATHN", "number": 3, "title": "Testing for Weak Lock Out Mechanism"},
    {"id": "WSTG-ATHN-04", "category": "ATHN", "number": 4, "title": "Testing for Bypassing Authentication Schema"},
    {"id": "WSTG-ATHN-05", "category": "ATHN", "number": 5, "title": "Testing for Vulnerable Remember Password"},
    {"id": "WSTG-ATHN-06", "category": "ATHN", "number": 6, "title": "Testing for Browser Cache Weaknesses"},
    {"id": "WSTG-ATHN-07", "category": "ATHN", "number": 7, "title": "Testing for Weak Password Policy"},
    {"id": "WSTG-ATHN-08", "category": "ATHN", "number": 8, "title": "Testing for Weak Security Question Answer"},
    {"id": "WSTG-ATHN-09", "category": "ATHN", "number": 9, "title": "Testing for Weak Password Change or Reset Functionalities"},
    {"id": "WSTG-ATHN-10", "category": "ATHN", "number": 10, "title": "Testing for Weaker Authentication in Alternative Channel", "scope": "out_of_scope", "reason": "Alternative authentication channels (mobile app, call centre, IVR) lie outside the scanned surface."},
    {"id": "WSTG-ATHZ-01", "category": "ATHZ", "number": 1, "title": "Testing Directory Traversal File Include"},
    {"id": "WSTG-ATHZ-02", "category": "ATHZ", "number": 2, "title": "Testing for Bypassing Authorization Schema"},
    {"id": "WSTG-ATHZ-03", "category": "ATHZ", "number": 3, "title": "Testing for Privilege Escalation"},
    {"id": "WSTG-ATHZ-04", "category": "ATHZ", "number": 4, "title": "Testing for Insecure Direct Object References"},
