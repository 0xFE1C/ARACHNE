{
  "framework": "iso27001",
  "name": "ISO/IEC 27001:2022 Annex A",
  "edition": "2022",
  "kind": "control",
  "total": 93,
  "source": "ISO/IEC 27001:2022 Annex A control titles, taken from the open-source CISO Assistant framework library (intuitem/ciso-assistant-community, backend/library/libraries/iso27001-2022.yaml, which is described as 'the outline of the ISO27001-2022 standard'; full standard: https://www.iso.org/standard/27001). Cross-checked against a second independent dataset (github.com/Marcus-Nightingale/ISO27001-2022-Control-Bento, controls.json).",
  "retrieved": "2026-11-05",
  "notes": "ISO/IEC 27001:2022 Annex A has 93 controls in four themes: A.5 Organisational (37), A.6 People (8), A.7 Physical (14), A.8 Technological (34). Titles are the official short control names. The standard itself is paywalled by ISO; the titles were taken from a widely used open-source library and verified 93/93 against a second, independent open-source dataset (differences limited to capitalisation). ISO/IEC 27001:2022 replaced the 2013 edition's 114 controls; do not mix the two.",
  "cross_check": "All 93 ids compared against a second, independent open-source dataset; the two differ only in capitalisation and spelling of five titles, each resolved to the official short name. A.5.15 and A.8.5 hand-checked.",
  "group_reasons": {
    "A.5": "an organisational control (policy, process, supplier relationship or incident-handling activity): its evidence is documents and management review, not a scan",
    "A.6": "a people control (screening, terms of employment, training, disciplinary process): no technical artefact exists for a scanner to observe",
    "A.7": "a physical control (perimeter, entry, media, equipment): no artefact a remote scanner can observe",
    "A.8": "no shipped ARACHNE check produces evidence about this technological control"
  },
  "default_reason": "no shipped ARACHNE check produces evidence about this control",
  "group_key": "group",
