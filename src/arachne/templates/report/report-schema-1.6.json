    "Branding": {
      "additionalProperties": false,
      "description": "White-label presentation for a report (S14, MSSP use case).\n\nThe default is the neutral ARACHNE presentation, so a report rendered with no branding\nis byte-identical to the pre-S14 output (the renderers only add a block when\n:meth:`is_customised`). A project stores its branding as YAML/JSON; every value here is\noperator-supplied, so colours and the logo URL are validated at construction rather\nthan escaped downstream.\n\n``logo_url`` is **HTML/PDF only** and must be ``https``/``http``/``data:image`` \u2014 the\nMarkdown renderer prints ``logo_text`` (initials) instead, because Markdown has no\ndependable way to carry a remote image into a text report. ``classification`` is the\nhandling banner (``CONFIDENTIAL``, ``INTERNAL``); it is printed on every page footer.",
      "properties": {
        "accent_color": {
          "default": "#c00000",
          "title": "Accent Color",
          "type": "string"
        },
        "classification": {
          "default": "",
          "title": "Classification",
          "type": "string"
        },
        "company_name": {
          "default": "",
          "title": "Company Name",
          "type": "string"
        },
        "contact": {
          "default": "",
          "title": "Contact",
          "type": "string"
        },
        "footer_text": {
          "default": "",
          "title": "Footer Text",
          "type": "string"
        },
        "logo_text": {
          "default": "",
          "title": "Logo Text",
          "type": "string"
        },
        "logo_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logo Url"
        },
        "primary_color": {
          "default": "#1f4e79",
          "title": "Primary Color",
          "type": "string"
        },
        "product_name": {
          "default": "ARACHNE",
          "title": "Product Name",
          "type": "string"
        },
        "show_arachne_branding": {
          "default": true,
          "title": "Show Arachne Branding",
          "type": "boolean"
        },
        "tagline": {
          "default": "",
          "title": "Tagline",
          "type": "string"
        }
      },
      "title": "Branding",
      "type": "object"
    },
