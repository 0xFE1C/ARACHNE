    "AttackPathHop": {
      "additionalProperties": false,
      "description": "One hop of a chain as the report renders it (REQ-AGENT-003).\n\n``verified`` is the load-bearing field: a hop the analyzer accepted is evidence, and one it\ndid not is a *candidate* that names the check which would verify it. A report that showed\nboth the same way would be claiming a chain it cannot support.",
      "properties": {
        "asset": {
          "default": "",
          "title": "Asset",
          "type": "string"
        },
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "finding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding Id"
        },
        "marker": {
          "default": "",
          "title": "Marker",
          "type": "string"
        },
        "severity": {
          "title": "Severity",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        },
        "verifying_check": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
