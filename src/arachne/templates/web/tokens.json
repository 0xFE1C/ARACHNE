{
  "name": "arachne-ui",
  "version": "1.0.0",
  "spec": ".spec/06-ui-ux.md §3 (SPEC-UIX-001 v1.0.0)",
  "note": [
    "The single source of truth for the web UI's colour, type, spacing, radius, elevation and",
    "motion (REQ-UIX-004). Nothing else may name a colour or a length: app.css and every",
    "template refer to the generated custom properties by name, and",
    "`python -m arachne.api.tokens --check` fails on a raw hex colour or a raw px length in a",
    "hand-written stylesheet or template.",
    "Colour and dimension values are the specification's; the `layout`/`component` groups exist",
    "only so the structural lengths app.css needs (a container width, a chart height, a 1 px",
    "rule) are tokens too, rather than the last few literals.",
    "`severity-ink` and `on-accent` are the per-theme foreground for a coloured badge or a",
    "primary button; the spec's colour column gives the background of each severity but not the",
    "ink that sits on it, and that ink has to flip with the theme (dark ink on the light dark-mode",
    "severities, white on the dark light-mode ones)."
  ],
  "base": {
    "--font-family-sans": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "--font-family-mono": "ui-monospace, \"SF Mono\", \"Cascadia Mono\", Menlo, monospace",
    "--font-size-xs": "0.75rem",
    "--font-size-sm": "0.875rem",
    "--font-size-md": "1rem",
    "--font-size-lg": "1.25rem",
    "--font-size-xl": "1.5rem",
    "--font-size-2xl": "2rem",
    "--font-size-h1": "1.25rem",
    "--font-size-h2": "1rem",
    "--font-size-h3": "0.875rem",
    "--font-weight-regular": "400",
    "--font-weight-medium": "500",
    "--font-weight-bold": "600",
    "--line-height-tight": "1.25",
    "--line-height-normal": "1.5",
    "--space-1": "4px",
    "--space-2": "8px",
    "--space-3": "12px",
    "--space-4": "16px",
    "--space-5": "20px",
    "--space-6": "24px",
    "--space-7": "32px",
    "--space-8": "40px",
    "--space-9": "48px",
    "--space-10": "64px",
    "--space-11": "80px",
    "--space-12": "96px",
    "--radius-sm": "4px",
    "--radius-md": "6px",
    "--radius-lg": "10px",
    "--radius-full": "9999px",
    "--shadow-1": "0 1px 2px rgb(0 0 0 / 0.06)",
    "--shadow-2": "0 4px 12px rgb(0 0 0 / 0.10)",
    "--duration-fast": "120ms",
    "--duration-normal": "200ms",
    "--easing-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "--border-width": "1px",
    "--focus-ring-width": "2px",
    "--focus-ring-offset": "2px",
    "--target-min": "24px",
    "--control-height": "32px",
    "--layout-max-width": "1400px",
    "--layout-grid-min": "320px",
    "--layout-field-width": "160px",
    "--layout-login-width": "420px",
    "--layout-chart-height": "80px",
    "--layout-chart-bar": "14px",
    "--layout-checkbox-column": "32px",
    "--breakpoint-sm": "48em",
    "--breakpoint-md": "64em",
    "--breakpoint-lg": "80em",
    "--breakpoint-xl": "90em"
  },
  "modes": {
    "theme": {
      "light": {
        "--color-surface-0": "#FFFFFF",
        "--color-surface-1": "#F7F8FA",
        "--color-surface-2": "#EEF0F4",
        "--color-border": "#D8DCE3",
        "--color-control-border": "#7A8291",
        "--color-text-primary": "#12161D",
        "--color-text-secondary": "#4A5260",
        "--color-text-disabled": "#8A93A3",
        "--color-accent": "#2B5CE6",
        "--color-accent-hover": "#1F49C0",
        "--color-critical": "#B3261E",
        "--color-high": "#C2410C",
        "--color-medium": "#A16207",
        "--color-low": "#3F6212",
        "--color-info": "#1E5F8A",
        "--color-success": "#166534",
        "--color-warning": "#854D0E",
        "--color-danger-bg": "#FDECEA",
        "--color-focus": "#2B5CE6",
        "--color-selected-bg": "#E4E9F7",
        "--color-severity-ink": "#FFFFFF",
        "--color-on-accent": "#FFFFFF"
      },
      "dark": {
        "--color-surface-0": "#0B0D12",
        "--color-surface-1": "#141821",
        "--color-surface-2": "#1E2430",
        "--color-border": "#2B3240",
        "--color-control-border": "#6B7484",
        "--color-text-primary": "#E8EBF0",
        "--color-text-secondary": "#A3ADBE",
        "--color-text-disabled": "#5C6677",
        "--color-accent": "#6D93FF",
        "--color-accent-hover": "#8AA9FF",
        "--color-critical": "#FF6B60",
        "--color-high": "#FF9A5A",
        "--color-medium": "#F2C55C",
        "--color-low": "#A8D05C",
        "--color-info": "#79B8E6",
        "--color-success": "#5FD08A",
        "--color-warning": "#F0B44C",
        "--color-danger-bg": "#2A1512",
        "--color-focus": "#8AA9FF",
        "--color-selected-bg": "#1D2942",
        "--color-severity-ink": "#0B0D12",
        "--color-on-accent": "#0B0D12"
      }
    },
    "density": {
      "comfortable": {
        "--density-control-pad-y": "8px",
        "--density-control-pad-x": "12px",
        "--density-cell-pad-y": "8px",
        "--density-cell-pad-x": "12px",
        "--density-panel-pad": "16px",
        "--density-shell-pad": "16px",
        "--density-header-pad-y": "8px",
        "--density-header-pad-x": "16px",
        "--density-row-gap": "16px",
        "--density-badge-pad-y": "4px",
        "--density-badge-pad-x": "8px",
        "--density-detail-pad": "12px"
      },
      "compact": {
        "--density-control-pad-y": "4px",
        "--density-control-pad-x": "8px",
        "--density-cell-pad-y": "4px",
        "--density-cell-pad-x": "8px",
        "--density-panel-pad": "8px",
        "--density-shell-pad": "8px",
        "--density-header-pad-y": "4px",
        "--density-header-pad-x": "8px",
        "--density-row-gap": "8px",
        "--density-badge-pad-y": "4px",
        "--density-badge-pad-x": "4px",
        "--density-detail-pad": "8px"
      }
    }
  },
  "contrast": [
    {"kind": "text", "min": 4.5, "fg": "--color-text-primary", "bg": "--color-surface-0", "use": "body and headings on the page"},
    {"kind": "text", "min": 4.5, "fg": "--color-text-primary", "bg": "--color-surface-1", "use": "body on a panel"},
    {"kind": "text", "min": 4.5, "fg": "--color-text-primary", "bg": "--color-surface-2", "use": "body on a hovered or selected row"},
    {"kind": "text", "min": 4.5, "fg": "--color-text-secondary", "bg": "--color-surface-0", "use": "metadata on the page"},
    {"kind": "text", "min": 4.5, "fg": "--color-text-secondary", "bg": "--color-surface-1", "use": "labels and metadata on a panel"},
    {"kind": "text", "min": 4.5, "fg": "--color-text-secondary", "bg": "--color-surface-2", "use": "metadata on a hovered row"},
    {"kind": "text", "min": 4.5, "fg": "--color-accent", "bg": "--color-surface-0", "use": "links on the page"},
    {"kind": "text", "min": 4.5, "fg": "--color-accent", "bg": "--color-surface-1", "use": "links on a panel"},
    {"kind": "text", "min": 4.5, "fg": "--color-accent", "bg": "--color-surface-2", "use": "links on a hovered row"},
    {"kind": "text", "min": 4.5, "fg": "--color-accent-hover", "bg": "--color-surface-0", "use": "a hovered link"},
    {"kind": "text", "min": 4.5, "fg": "--color-critical", "bg": "--color-surface-1", "use": "an error message on a panel"},
    {"kind": "text", "min": 4.5, "fg": "--color-critical", "bg": "--color-danger-bg", "use": "an error message on the error surface"},
    {"kind": "text", "min": 4.5, "fg": "--color-text-primary", "bg": "--color-danger-bg", "use": "explanation on the error surface"},
    {"kind": "text", "min": 4.5, "fg": "--color-text-primary", "bg": "--color-selected-bg", "use": "a selected finding row in the triage workspace (REQ-UIX-006)"},
    {"kind": "text", "min": 4.5, "fg": "--color-text-secondary", "bg": "--color-selected-bg", "use": "the muted columns of a selected finding row"},
    {"kind": "text", "min": 4.5, "fg": "--color-success", "bg": "--color-surface-1", "use": "a success or verified note"},
    {"kind": "text", "min": 4.5, "fg": "--color-warning", "bg": "--color-surface-1", "use": "a degraded or stale note"},
    {"kind": "text", "min": 4.5, "fg": "--color-info", "bg": "--color-surface-1", "use": "a neutral notice"},
    {"kind": "text", "min": 4.5, "fg": "--color-on-accent", "bg": "--color-accent", "use": "a primary button's label"},
    {"kind": "text", "min": 4.5, "fg": "--color-on-accent", "bg": "--color-accent-hover", "use": "a hovered primary button's label"},
    {"kind": "text", "min": 4.5, "fg": "--color-severity-ink", "bg": "--color-critical", "use": "the critical badge"},
    {"kind": "text", "min": 4.5, "fg": "--color-severity-ink", "bg": "--color-high", "use": "the high badge"},
    {"kind": "text", "min": 4.5, "fg": "--color-severity-ink", "bg": "--color-medium", "use": "the medium badge"},
    {"kind": "text", "min": 4.5, "fg": "--color-severity-ink", "bg": "--color-low", "use": "the low badge"},
    {"kind": "text", "min": 4.5, "fg": "--color-severity-ink", "bg": "--color-info", "use": "the info badge"},
    {"kind": "text", "min": 4.5, "fg": "--color-severity-ink", "bg": "--color-success", "use": "the success badge"},
    {"kind": "text", "min": 4.5, "fg": "--color-severity-ink", "bg": "--color-warning", "use": "the warning badge"},
    {"kind": "ui", "min": 3.0, "fg": "--color-focus", "bg": "--color-surface-0", "use": "the focus ring on the page (WCAG 1.4.11)"},
    {"kind": "ui", "min": 3.0, "fg": "--color-focus", "bg": "--color-surface-1", "use": "the focus ring on a panel (WCAG 1.4.11)"},
    {"kind": "ui", "min": 3.0, "fg": "--color-control-border", "bg": "--color-surface-1", "use": "a control's boundary on a panel: the field's fill is the same near-white as the panel, so the border is what identifies the control and 1.4.11 asks it for 3:1 (WP-06)"},
    {"kind": "ui", "min": 3.0, "fg": "--color-control-border", "bg": "--color-surface-2", "use": "a button's boundary on its own fill (WCAG 1.4.11, WP-06)"},
    {"kind": "disabled", "min": 3.0, "fg": "--color-text-disabled", "bg": "--color-surface-0", "use": "a disabled control's label; WCAG 1.4.3 exempts inactive components, this is the internal floor and the only background a disabled control is styled on"}
  ]
}
