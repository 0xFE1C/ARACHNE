{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arachne.invalid/schemas/webhooks/audit.v1.0.json",
  "title": "ARACHNE webhook event audit 1.0",
  "description": "One SIEM record per audit event, already redacted.",
  "type": "object",
  "required": [
    "action",
    "event",
    "outcome",
    "schema_version"
  ],
  "properties": {
    "event": {
      "type": "string",
      "description": "the event name (REQ-ECOS-009)"
    },
    "schema_version": {
      "type": "string",
      "description": "the version of this event's shape"
    },
    "action": {
      "description": "the audit action"
    },
    "outcome": {
      "description": "the audit outcome"
    }
  },
  "additionalProperties": true
}
