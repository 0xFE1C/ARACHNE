{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arachne.invalid/schemas/webhooks/scan.teams.v1.0.json",
  "title": "ARACHNE webhook event scan.teams 1.0",
  "description": "A scan-completion MessageCard posted to a Teams incoming webhook.",
  "type": "object",
  "required": [
    "event",
    "schema_version",
    "text",
    "title"
  ],
  "properties": {
    "event": {
      "type": "string",
      "description": "the event name (REQ-ECOS-009)"
    },
    "schema_version": {
      "type": "string",
      "description": "the version of this event's shape"
    },
    "title": {
      "description": "the card title"
    },
    "text": {
      "description": "the rendered card body"
    }
  },
  "additionalProperties": true
}
