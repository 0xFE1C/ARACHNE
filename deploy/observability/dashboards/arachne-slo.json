    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Fraction of finished scans that completed rather than failed, over the objective window. Bounded by the scan farm's scrape coverage: a worker that is not scraped contributes nothing to either side of the ratio. Objective 95% over 7d. Runbook: docs/operator-guide.md#523-scan-completion-the-queue-drains",
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "id": 4,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "expr": "sum(rate(arachne_scans_total{status=\"completed\"}[7d])) / sum(rate(arachne_scans_total{status=~\"completed|failed\"}[7d]))",
          "legendFormat": "SLI",
          "refId": "A"
        }
      ],
      "title": "Scan completion \u2014 current",
      "type": "stat"
    },
