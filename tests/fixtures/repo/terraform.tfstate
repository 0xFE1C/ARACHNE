{
  "version": 4,
  "terraform_version": "1.7.5",
  "serial": 12,
  "lineage": "lab-state",
  "outputs": {
    "db_endpoint": {
      "value": "db.internal.arachne.test:5432",
      "type": "string"
    }
  },
  "resources": [
    {
      "mode": "managed",
      "type": "aws_db_instance",
      "name": "main",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "attributes": {
            "id": "db-main",
            "engine": "postgres",
            "publicly_accessible": true,
            "password": "state-db-password-9f3a",
            "username": "arachne",
            "connection_string": "postgres://arachne:state-db-password-9f3a@db.internal:5432/app"
          }
        }
      ]
    }
  ]
}